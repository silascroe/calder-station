{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "town-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
