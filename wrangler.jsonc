{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "town-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-30",
  "limits": {
    "cpu_ms": 300000
  },
  "workers_dev": true,
  "vars": {
    "TOWN_ENV": "production"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TOWN",
        "class_name": "RookwoodTown"
      }
    ]
  },
  "exports": {
    "RookwoodTown": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": {
      "name": "town-dashboard-staging",
      "vars": {
        "TOWN_ENV": "staging",
        "MODEL_EVALUATION_REVISION": "sal-resumable-season-v9-2026-08-31"
      },
      "limits": {
        "cpu_ms": 300000
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "TOWN",
            "class_name": "RookwoodTown"
          }
        ]
      }
    }
  }
}
